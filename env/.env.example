# ==============================================================================
# PLATFORMS TRAINING ACADEMY — ENVIRONMENT TEMPLATE (env/.env.example)
# ==============================================================================
# Copy this file to `env/.env` for local development, or configure these
# environment variables in your Render.com Dashboard -> Environment tab.
# NEVER commit real secrets to `env/.env.example`.
# ==============================================================================

# 1. Flask Server & Session Security
FLASK_ENV=production
FLASK_SECRET_KEY=<YOUR_64_CHAR_RANDOM_HEX_SECRET>
PORT=5000

# 2. Instructor & Admin Portal Authentication
ADMIN_PIN=<YOUR_ADMIN_PIN>
ADMIN_SECONDARY_PIN=<YOUR_SECONDARY_ADMIN_PIN>
ADMIN_VOUCHER_CODE=<YOUR_INSTRUCTOR_VOUCHER_CODE>

# 3. Stripe Payment Processing & Webhook Security (Server-Side Only)
STRIPE_PUBLISHABLE_KEY=<YOUR_STRIPE_PUBLISHABLE_KEY>
STRIPE_SECRET_KEY=<YOUR_STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<YOUR_STRIPE_WEBHOOK_SECRET>
STRIPE_URL_UNARMED_20=https://buy.stripe.com/6oU4gz8oQeaD1Moaqs9oc08
STRIPE_URL_ARMED_28=https://buy.stripe.com/4gMaEXdJa9Un3Uw4249oc01

# 4. Transactional Email (SMTP) Credentials
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=charlesyoung@platformstraining.com
SMTP_PASS=<YOUR_SMTP_APP_PASSWORD>
SMTP_FROM=charlesyoung@platformstraining.com
SMTP_USE_TLS=true

# 5. EmailJS Cloud MFA Configuration
EMAILJS_SERVICE_ID=service_bor93nt
EMAILJS_TEMPLATE_ID=template_0k00oka
EMAILJS_PUBLIC_KEY=qZROJMBteQvfuYHqG
EMAILJS_PRIVATE_KEY=<YOUR_OPTIONAL_EMAILJS_PRIVATE_KEY>

# 6. Google Business Profile Review Link
GOOGLE_REVIEW_URL=https://www.google.com/maps/search/?api=1&query=Platforms+Training+Academy+200+E+75th+St+Chicago+IL+60619

# 7. GitHub Deployment Token
GITHUB_PERSONAL_ACCESS_TOKEN=<YOUR_GITHUB_PERSONAL_ACCESS_TOKEN>

# 8. MongoDB Cloud Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=platforms_training_academy
